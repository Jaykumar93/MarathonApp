{
  "expo": {
    "name": "Stryde",
    "slug": "marathonapp",
    "scheme": "stryde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaykumar093.stryde"
    },
    "android": {
      "package": "com.jaykumar093.stryde",
      "adaptiveIcon": {
        "backgroundColor": "#14161A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3f6a427f-5cf3-4739-a2c0-e7842a80e6f8"
      }
    },
    "owner": "jaykumar093",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Stryde uses your location, including while your screen is off or another app is open, to keep tracking your route, distance, and pace for the whole run.",
          "locationWhenInUsePermission": "Stryde uses your location while a run is active to track your route, distance, and pace.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stryde uses your photos to attach pictures to a logged run and to build its shareable route card."
        }
      ],
      "@sentry/react-native",
      "expo-dev-client",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyB4jHmtjcJSjy7p5gYvxj_I406liVxpr5Y"
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "color": "#FF5A1F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
