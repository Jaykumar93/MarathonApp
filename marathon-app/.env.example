# Copy this file to .env and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
# Only the anon/public key goes here for anything EXPO_PUBLIC_-prefixed —
# it's safe for client apps since Row Level Security policies gate actual
# data access. Never put the service_role key under an EXPO_PUBLIC_ name;
# Expo inlines only that prefix into the app bundle, so anything without it
# (like SUPABASE_SERVICE_ROLE_KEY below) never ships to a device even
# though it lives in this same file - it's only ever read by scripts run
# on your own machine (`npm run coach:seed`), never imported into app code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash reporting (free tier). Get this from your Sentry project's
# Settings -> Client Keys (DSN). Leave blank to run with Sentry disabled -
# app/_layout.tsx skips Sentry.init() entirely when this is unset.
EXPO_PUBLIC_SENTRY_DSN=

# Server-side only (Project Settings -> API -> service_role, or
# `supabase projects api-keys --project-ref <ref>`) - bypasses Row Level
# Security entirely. Used only by scripts/seedKnowledgeBase.ts to write
# knowledge_base, which authenticated users can't (see that table's RLS
# policy). Never referenced from anything under app/ or components/.
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face Inference API key (free tier) - used by
# scripts/seedKnowledgeBase.ts and the coach-chat Edge Function to embed
# text for the AI Coach's pgvector knowledge-base search. Server-side only,
# same reasoning as SUPABASE_SERVICE_ROLE_KEY above.
HF_API_KEY=
