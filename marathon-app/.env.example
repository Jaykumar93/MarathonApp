# Copy this file to .env and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
# Only the anon/public key goes here — it's safe for client apps since
# Row Level Security policies gate actual data access. Never put the
# service_role key in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash reporting (free tier). Get this from your Sentry project's
# Settings -> Client Keys (DSN). Leave blank to run with Sentry disabled -
# app/_layout.tsx skips Sentry.init() entirely when this is unset.
EXPO_PUBLIC_SENTRY_DSN=
