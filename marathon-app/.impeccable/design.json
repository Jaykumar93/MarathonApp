  "narrative": {
    "northStar": "The Profile Line",
    "overview": "A training block is a line drawn across terrain: low base weeks, a climb, a peak, a taper down to a flag. The mark is that line, and the system follows it. The ground is deep ink-blue (or warm bone in light mode), surfaces are flat and edged by hairlines, and a single ultraviolet line of colour marks the one thing to do next.\n\nThe system is calm and confident, with generous 12 to 16px curves, quiet type and one clear action per screen. Active Run and Track stay dark in both themes because they are read outdoors, mid-stride. Pika, a small mountain goat, is the only illustration and appears only at calm or good moments.",
    "keyCharacteristics": [
      "Dark-first ground, with a fully designed light twin (same hues, different surfaces).",
      "One accent (ultraviolet) for action and emphasis; semantic colour for run types and state.",
      "Bricolage Grotesque for titles, Figtree for reading, Martian Mono for numbers and uppercase labels.",
      "Hairline borders define edges in both themes; cards are flat with no shadow.",
      "Glanceable: large numerals and strong contrast on the run screens."
    ],
    "rules": [
      {
        "name": "The One Line Rule",
        "body": "Violet is the single call to action on a screen. If two things are filled violet, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Text Role Rule",
        "body": "A hue used as text takes its *Text token, never the fill colour; the fill is only for marks and for the ground behind a white label.",
        "section": "colors"
      },
      {
        "name": "The Semantic Colour Rule",
        "body": "A run type keeps one colour everywhere (easy Moss, tempo Ultraviolet, interval Rose, long Glacier, race Marigold). Colour never decorates.",
        "section": "colors"
      },
      {
        "name": "The Not-A-Failure Rule",
        "body": "Missed or slow sessions are never red; red is reserved for destructive actions.",
        "section": "colors"
      },
      {
        "name": "The Pinned Type Rule",
        "body": "Every size comes from the scale, and each step pins fontSize, lineHeight and includeFontPadding together (text(\"body\")). A text style with a hand-typed size is a bug.",
        "section": "typography"
      },
      {
        "name": "The Numbers Are Mono Rule",
        "body": "Pace, distance, time and every stat value use Martian Mono; titles stay on Bricolage.",
        "section": "typography"
      },
      {
        "name": "The No-Typed-Icons Rule",
        "body": "Chevrons and carets are drawn icons, never typed characters.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Edges are drawn by a 1px hairline, so a card reads the same on iOS and Android.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use the type scale (text(\"body\")) and the four radii; never a hand-typed size or radius.",
      "Keep one violet action per screen.",
      "Use *Text tokens for coloured text and accentMark for marks.",
      "Draw icons (Ionicons); never type a glyph as an icon.",
      "Keep Active Run and Track dark, with colours from darkSurface.",
      "State missed or slow sessions neutrally.",
      "Put numbers in Martian Mono."
    ],
    "donts": [
      "Nest a bordered box inside a bordered card.",
      "Use red for anything but destructive actions.",
      "Use the fill hue as text on a light ground.",
      "Show Pika during a run or on an error.",
      "Give a control a fixed height that large system fonts would clip.",
      "Use fontWeight on top of a custom font family.",
      "Let the coach's UI imply it chooses training numbers."
    ]
  }
